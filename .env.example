# Copy this file to .env and fill in the values below.
# Never commit .env — it holds live API credentials (it is git-ignored).
#
# Only needed on the machine that runs `npm run fetch` (the scheduled task).
# Zoho blocks OAuth calls from cloud/datacenter IPs, so this has to be a
# normal office/home PC, not GitHub Actions or a hosting provider.

# --- Zoho data center ---------------------------------------------------
# One of: in | com | eu | com.au | jp  (must match the account's DC)
ZOHO_DC=in

# --- Zoho API OAuth (from https://api-console.zoho.<dc>/) --------------
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# --- Filters -------------------------------------------------------------
# Campaigns sent to fewer than this many recipients are excluded (test sends).
MIN_RECIPIENTS=50
# Only campaign names matching this regex (case-insensitive) are kept —
# filters out one-off product/marketing sends that aren't the newsletter.
NEWSLETTER_NAME_PATTERN=^news\s*letter
# A campaign sent to a mailing list whose name matches this is "Doctors";
# everything else is "Marketing".
DOCTOR_LIST_PATTERN=doctor

# --- Local preview (npm start) ------------------------------------------
PORT=4100
